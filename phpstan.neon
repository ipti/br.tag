parameters:
    level: 3
    paths:
        - app/components
    scanDirectories:
        - app/models
        - app/modules/curricularmatrix/models
    excludePaths:
        - app/vendor (?)
        - app/runtime (?)
        - app/components/widgets
    bootstrapFiles:
        - phpstan-bootstrap.php
    reportUnmatchedIgnoredErrors: false

includes:
    - phpstan-baseline.neon
